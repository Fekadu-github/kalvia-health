# Database (defaults to local SQLite if unset)
DATABASE_URL=sqlite:///./care_platform.db

# Auth
JWT_SECRET=change-me-to-a-long-random-string
AUTH_MODE=oidc            # "dev" enables POST /auth/dev-login (local only)
ADMIN_BOOTSTRAP_SECRET=   # required once to create the first admin

# Public URLs
API_BASE_URL=http://127.0.0.1:8000
JITSI_BASE_URL=https://meet.jit.si

# Email (optional; prints to log if unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@kalviahealth.example
